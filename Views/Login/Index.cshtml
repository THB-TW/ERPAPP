@model LoginDto
@{ Layout=null; }
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 · 記帳日常</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-shell">
        <section class="login-intro"><span class="eyebrow">記帳日常</span><h1>把每筆收支，<br />安排得更清楚。</h1><p>記錄日常、安排預算，<br />一步一步完成每個月的核對。</p></section>
        <section class="login-form"><h2>歡迎回來</h2><p class="text-muted small">登入後，繼續整理你的財務紀錄。</p>
            <form asp-action="Index" method="post">
                <label asp-for="Account"></label><input class="form-control" asp-for="Account" autocomplete="username" placeholder="輸入帳號" required autofocus />
                <label asp-for="Password"></label><input class="form-control" asp-for="Password" type="password" autocomplete="current-password" placeholder="輸入密碼" required />
                <button class="btn btn-primary" type="submit">登入 →</button>
                <div class="message" role="alert">@(ViewBag?.Message??"")</div>
            </form>
        </section>
    </main>
</body>
</html>
