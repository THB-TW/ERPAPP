@model ERPAPP.ViewModels.BudgetWorkspacePage
@using ERPAPP.Services.Budgeting
@{ var current=Model.Current;var command=new BudgetCommand {Action="transfer",Month=Model.LatestMonth,Version=Model.State.Version,OperationId=Guid.NewGuid()}; }
@await Html.PartialAsync("_BudgetMessage")
<section class="card mb-4"><div class="card-header"><h3 class="h5 mb-0">目前分類儲備 · @Model.LatestMonth</h3></div><div class="card-body">
<p>總儲備金 <strong>@current.Reserve.ToString("N0")</strong> 元；可用餘額 @current.Spare.ToString("N0") 元；帳面總資產 @current.Total.ToString("N0") 元。</p>
<div class="table-responsive"><table class="table table-sm"><thead><tr><th>儲備類別</th><th class="text-end">累計可用</th><th>下期狀態</th></tr></thead><tbody>
@foreach(var category in Model.State.Categories.Where(c=>c.Kind=="reserve"))
{
    var balance=current.Balances.GetValueOrDefault(category.Id);
    <tr><td>@category.Name</td><td class="text-end @(balance<0?"text-danger":"")">@balance.ToString("N0")</td><td>@(Model.Active.Any(c=>c.Id==category.Id)?"使用中":"已停用，歷史保留")</td></tr>
}
</tbody></table></div>
@if(User.IsInRole("Edit"))
{
<details class="mb-3"><summary>用可用餘額補入預備金</summary><p class="text-muted">可用餘額減少、指定類別儲備增加；總資產、學費與其他類別不變。</p>
<form asp-controller="BudgetAdjustments" asp-action="Preview" method="post" class="row g-2">
    @await Html.PartialAsync("_BudgetCommandFields",new BudgetCommand {Action="fund",Month=Model.LatestMonth,Version=Model.State.Version,OperationId=Guid.NewGuid()})
    <div class="col-md-6"><label for="fund-to">補入類別</label><select id="fund-to" class="form-select" name="To">@foreach(var category in Model.Active.Where(c=>c.Kind=="reserve")){<option value="@category.Id">@category.Name（@current.Balances.GetValueOrDefault(category.Id).ToString("N0")）</option>}</select></div>
    <div class="col-md-6"><label for="fund-amount">補入金額（可用 @current.Spare.ToString("N0") 元）</label><input id="fund-amount" class="form-control" type="number" name="Amount" min="1" max="@Math.Max(0,current.Spare)" step="1" required /></div>
    <div class="col-12"><label for="fund-reason">原因</label><input id="fund-reason" class="form-control" name="Reason" maxlength="300" required /></div>
    <div><button class="btn btn-primary">預覽補入</button></div>
</form></details>
<details><summary>挪用預算補足缺口</summary><p class="text-muted">只在儲備類別間移轉，總儲備金與帳面總資產維持不變，不動可用餘額或學費。</p>
<form asp-controller="BudgetAdjustments" asp-action="Preview" method="post" class="row g-2">
    @await Html.PartialAsync("_BudgetCommandFields",command)
    <div class="col-md-4"><label for="transfer-from">轉出類別</label><select id="transfer-from" class="form-select" name="From">@foreach(var category in Model.Active.Where(c=>c.Kind=="reserve")){<option value="@category.Id">@category.Name（@current.Balances.GetValueOrDefault(category.Id).ToString("N0")）</option>}</select></div>
    <div class="col-md-4"><label for="transfer-to">轉入類別</label><select id="transfer-to" class="form-select" name="To">@foreach(var category in Model.Active.Where(c=>c.Kind=="reserve")){<option value="@category.Id">@category.Name</option>}</select></div>
    <div class="col-md-4"><label for="transfer-amount">挪用金額</label><input id="transfer-amount" class="form-control" type="number" name="Amount" min="1" step="1" required /></div>
    <div class="col-12"><label for="transfer-reason">原因</label><input id="transfer-reason" class="form-control" name="Reason" maxlength="300" required /></div>
    <div><button class="btn btn-primary">預覽挪用</button></div>
</form></details>
}
<p class="mt-3 mb-0"><a asp-controller="BudgetAdjustments" asp-action="History" asp-route-kind="adjustments">查看調整紀錄與沖銷</a> · <a asp-controller="BudgetCap" asp-action="Index">設定下期上限與分類</a></p>
</div></section>
