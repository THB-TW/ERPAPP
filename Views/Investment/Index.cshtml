@using ERPAPP.Services
@model ERPAPP.ViewModels.InvestmentIndexViewModel
@{
    ViewData["Title"] = "投資組合";
}

<div class="container-fluid">
    <h2>📈 @ViewData["Title"]</h2>

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-info">@TempData["AlertMessage"]</div>
    }

    <div class="mb-3">
        <a class="btn btn-outline-primary btn-sm" asp-action="Transactions">交易紀錄</a>
        <a class="btn btn-outline-primary btn-sm" asp-action="Valuation">填市值</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Holdings">標的維護</a>
    </div>

    @foreach (var p in Model.Positions.Where(p => p.Error != null))
    {
        <div class="alert alert-danger">
            ⚠️ 交易資料有誤，此標的未計入合計：@p.Error
            <a class="alert-link" asp-action="Transactions" asp-route-holdingId="@p.Holding.Id">前往修正</a>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="text-muted small">累計投入淨額（月結對帳用）</div>
                    <div class="fs-4 fw-bold">@Model.NetDeployed.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="text-muted small">持有成本合計</div>
                    <div class="fs-4 fw-bold">@Model.TotalCost.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="text-muted small">市值合計</div>
                    <div class="fs-4 fw-bold">@Model.TotalMarketValue.ToString("N0")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <div class="text-muted small">未實現損益</div>
                    <div class="fs-4 fw-bold @(Model.TotalUnrealized >= 0 ? "text-danger" : "text-success")">
                        @Model.TotalUnrealized.ToString("N0")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h5>持倉</h5>
    <div class="table-responsive">
        <table class="table table-bordered table-hover table-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>標的</th>
                    <th class="text-end">股數</th>
                    <th class="text-end">持有成本</th>
                    <th class="text-end">市值</th>
                    <th class="text-end">未實現</th>
                    <th class="text-end">已實現</th>
                    <th class="text-end">配息</th>
                    <th class="text-end">報酬率</th>
                    <th>估值時點</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Positions.Where(p => p.Error == null))
                {
                    <tr>
                        <td>
                            @(p.Holding.Symbol == null ? p.Holding.Name : $"{p.Holding.Symbol} {p.Holding.Name}")
                            <span class="badge bg-secondary">@p.Holding.AssetClass</span>
                        </td>
                        <td class="text-end">@(p.Holding.AssetClass == InvestmentTerms.StockClass ? p.Quantity.ToString("0.####") : "—")</td>
                        <td class="text-end">@p.Cost.ToString("N0")</td>
                        <td class="text-end">
                            @p.MarketValue.ToString("N0")
                            @if (!p.HasValuation)
                            {
                                <span class="badge bg-warning text-dark">未估值</span>
                            }
                        </td>
                        <td class="text-end @(p.Unrealized >= 0 ? "text-danger" : "text-success")">@p.Unrealized.ToString("N0")</td>
                        <td class="text-end">@p.RealizedPnl.ToString("N0")</td>
                        <td class="text-end">@p.Dividends.ToString("N0")</td>
                        <td class="text-end">@(p.ReturnRate.HasValue ? p.ReturnRate.Value.ToString("0.##") + "%" : "—")</td>
                        <td class="small text-muted">
                            @(p.HasValuation ? p.ValuationAsOf?.ToString("yyyy-MM-dd HH:mm") : "以成本代替")
                            @if (p.Holding.AssetClass == InvestmentTerms.StockClass && p.UnitPrice.HasValue)
                            {
                                <span>（@p.UnitPrice.Value.ToString("0.####")/股）</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="form-text text-muted">
        市值＝目前股數 × 最新股價（台股）／最新填入總額（虛擬貨幣）。「未估值」表示尚無快照，以成本代替。
        虛擬貨幣採成本收回法：賣出直接沖減成本、不認列已實現損益，成本可能為負（代表已收回超過投入）。
    </p>

    <h5 class="mt-4">財產分配（@Model.PropertyMonth 帳面 ＋ 投資市值）</h5>
    <div style="position: relative; height: 220px;">
        <canvas id="allocationChart"></canvas>
    </div>
    <div class="table-responsive mt-2">
        <table class="table table-bordered table-sm w-auto">
            <thead class="table-dark">
                <tr>
                    <th>可用餘額（已扣投資）</th>
                    <th>學費儲備</th>
                    <th>總儲備金</th>
                    <th>台股</th>
                    <th>虛擬貨幣</th>
                </tr>
            </thead>
            <tbody>
                <tr class="text-end">
                    <td class="@(Model.SpareAfterInvest < 0 ? "text-danger" : "")">@Model.SpareAfterInvest.ToString("N0")</td>
                    <td>@Model.Tuitionfee.ToString("N0")</td>
                    <td>@Model.BudgetReserve.ToString("N0")</td>
                    <td>@Model.StockMarketValue.ToString("N0")</td>
                    <td>@Model.CryptoMarketValue.ToString("N0")</td>
                </tr>
            </tbody>
        </table>
    </div>
    <p class="form-text text-muted">
        可用餘額＝Property.Sparemoney − 累計投入淨額（那部分錢已經變成投資，不能兩邊都算）。
        為負代表投入投資的錢超過帳上的可用餘額——刻意照實顯示，不會蓋成 0。
    </p>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // 一根堆疊長條、五段。BudgetReport 的圖沒有 stacked 設定，這裡必須自己開，
        // 否則五段會畫成並排。可用餘額可為負，會畫在軸線左側。
        var alloc = {
            spare: @Model.SpareAfterInvest,
            tuition: @Model.Tuitionfee,
            reserve: @Model.BudgetReserve,
            stock: @Model.StockMarketValue,
            crypto: @Model.CryptoMarketValue
        };
        new Chart(document.getElementById('allocationChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['財產分配'],
                datasets: [
                    { label: '可用餘額', data: [alloc.spare], backgroundColor: 'rgba(255, 99, 132, 0.7)' },
                    { label: '學費儲備', data: [alloc.tuition], backgroundColor: 'rgba(255, 159, 64, 0.7)' },
                    { label: '總儲備金', data: [alloc.reserve], backgroundColor: 'rgba(54, 162, 235, 0.7)' },
                    { label: '台股', data: [alloc.stock], backgroundColor: 'rgba(75, 192, 192, 0.7)' },
                    { label: '虛擬貨幣', data: [alloc.crypto], backgroundColor: 'rgba(153, 102, 255, 0.7)' }
                ]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: { stacked: true, ticks: { callback: function (v) { return v.toLocaleString(); } } },
                    y: { stacked: true }
                },
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function (ctx) {
                                return ctx.dataset.label + ': ' + ctx.parsed.x.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
    </script>
}
