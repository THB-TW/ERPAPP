@model ERPAPP.Models.Transaction

@{
    ViewData["Title"] = "新增交易";
}


<hr />
<div class="row">
    <div class="col-lg-7 form-surface">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Category"></label>
                <select asp-for="Category" class="form-control" asp-items="ViewBag.Categories">
                    <option value="">請選擇類別</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Amount" class="control-label"></label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Member"></label>
                <select asp-for="Member" class="form-control" asp-items="ViewBag.Members">
                    <option value="">請選擇成員</option>
                </select>
                <span asp-validation-for="Member" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Account"></label>
                <select asp-for="Account" class="form-control" asp-items="ViewBag.Accounts">
                    <option value="">請選擇帳戶</option>
                </select>
                <span asp-validation-for="Account" class="text-danger"></span>
            </div>


            <div class="form-group">
                <input type="submit" value="新增交易" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">返回交易明細</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
