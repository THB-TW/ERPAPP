{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "expo-file-system": ["./node_modules/expo-file-system", "./node_modules/expo/node_modules/expo-file-system"]
    },
    "types": ["node"]
  },
  "include": ["src", "tools", "expo-env.d.ts", ".expo/types/**/*.ts"]
}
